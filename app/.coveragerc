[run]
source = apps,server,utils
omit =
    */tests/*
    */conftest.py
    */__pycache__/*
    */.venv/*
    */main.py
    */routes.py
    */server.py
    */generator.py
    */run.py
    */utils/dify.py
    */utils/speechmatics.py
    */utils/archive_utils.py
    */utils/b64tools.py
    */utils/imagetools.py
    */utils/media.py
    */utils/openrouter.py
    */utils/pdftools.py
    */utils/downloaders/*
    */apps/youtube/services.py
    */apps/ocr/paddle_ocr_services.py
    */apps/ocr/ocr_services.py
    */apps/ocr/no_ocr_services.py
    */apps/language/prompts/parser.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
