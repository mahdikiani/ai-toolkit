PROJECT_NAME=ai-toolkit
DOMAIN=toolkit.uln.me
STORAGE_PATH=

DEBUG=1
MONGO_URI=mongodb://mongo:27017/
REDIS_URI=redis://redis:6379

CORS_ORIGINS='["http://localhost:8000"]'
JWT_CONFIG='{"jwks_url": "https://usso.uln.me/.well-known/jwks.json"}'
USSO_BASE_URL=https://usso.uln.me

FINANCE_BASE_URL=https://saas.uln.me/api/saas/v1/
FINANCE_API_KEY=
MEDIA_BASE_URL=https://media.uln.me/api/media/v1/
MEDIA_API_KEY=

USSO_NAMESPACE=

GEMINI_API_KEY=
METIS_API_KEY=
PISHRUN_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-4o-mini
DEFAULT_TTS_MODEL=openai/gpt-4o-mini-tts
OPENAI_COMPAT_MODELS=

SONIOX_API_KEY=
# Shared secret for inbound Soniox webhooks (HMAC token on callback URL). Required.
SONIOX_WEBHOOK_SECRET=
# Realtime STT WebSocket proxy (WS /api/ai/v1/transcribes/realtime)
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_RT_MODEL=stt-rt-v5
SONIOX_RT_LANGUAGE_HINTS=["fa", "en"]
# Max in-memory audio buffer for a live session (bytes). Default 50 MiB.
SONIOX_RT_MAX_BUFFER_BYTES=52428800
YOUTUBE_TRANSCRIPT_API_KEY=

# OCR engine switch: pipeline | document_intelligence | llm | paddleocr_vl_1_5
# Per-request body field `ocr_engine` overrides this default.
OCR_ENGINE=pipeline
OCR_PIPELINE_DPI=300
OCR_PIPELINE_ENABLE_LAYOUT=true
OCR_PIPELINE_ENABLE_PREPROCESSING=true
OCR_VLM_MODEL=google/gemini-3.1-flash-lite
OCR_DI_CROP_PADDING_RATIO=0.10
OCR_DI_IOU_THRESHOLD=0.40
OCR_DI_MAX_CONCURRENT_VLM=5
OCR_DI_OUTPUT_DEBUG=false
PADDLE_PIPELINE_NAME=PaddleOCR-VL-1.5
PADDLE_DEVICE=cpu

MINUTES_PRICE=1
TRANSCRIBE_ENABLE_CHUNKING=1
TRANSCRIBE_CHUNK_MIN_MINUTES=5
TRANSCRIBE_CHUNK_MAX_MINUTES=10
TRANSCRIBE_CHUNK_MIN_SILENCE_MS=750
TRANSCRIBE_CHUNK_SILENCE_THRESHOLD=-40
TRANSCRIBE_CHUNK_FORMAT=wav
TRANSCRIBE_MAX_PARALLEL_REQUESTS=3
TRANSCRIBE_POLL_INTERVAL_SECONDS=5
TRANSCRIBE_CHUNKING_FALLBACK_SINGLE=1

# Optional JSON pricing override. Keep empty object for defaults.
# Example:
# AI_TOOLKIT_PRICING={"text":{"markup":1.2,"default_per_1k_tokens":0.01},"ocr":{"default_per_page":1},"transcribe":{"providers":{"soniox":{"per_minute":1}}},"youtube":{"per_request":1}}
AI_TOOLKIT_PRICING={}
